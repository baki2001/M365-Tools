/* Catppuccin Mocha ("m365" theme, see theme.py). Every colour is a palette token: $base $mantle $crust
   $surface0 $surface1 $foreground $subtext0 $overlay0 $blue $lavender $mauve $green $yellow $peach $red $teal.
   Focus and selection are mauve; boxes are rounded surface1 and turn mauve when focused; boxes never touch. */

Screen {
    background: $base;
    color: $foreground;
    layout: vertical;
}

#header {
    height: 1;
    background: $mantle;
}

#body {
    height: 1fr;
}

#keybar {
    height: 1;
    background: $mantle;
}

/* ---------------------------------------------------------------- sidebar */

#nav {
    width: 26;
    height: 1fr;
    background: $mantle;
    padding: 1 0 0 0;
}

#sidebar {
    height: 1fr;
    max-height: 100%;
    border: none;
    padding: 0;
    background: $mantle;
    scrollbar-size-vertical: 0;
}

#sidebar:focus {
    border: none;
    background-tint: $foreground 0%;
}

#sidebar > .option-list--option {
    padding: 0 1;
}

#sidebar > .option-list--separator {
    color: $mantle;
}

#sidebar > .option-list--option-highlighted {
    background: $surface1;
    color: $foreground;
    text-style: none;
}

#sidebar:focus > .option-list--option-highlighted {
    background: $mauve;
    color: $crust;
    text-style: none;
}

#sidebar > .option-list--option-hover {
    background: $surface0;
}

#nav-status {
    height: auto;
    padding: 0 1;
    border-top: solid $surface0;
    background: $mantle;
}

/* ---------------------------------------------------------------- main pane */

#main {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $base;
    border-left: outer $base;
}

#main:focus-within {
    border-left: outer $mauve;
}

#switcher, .section {
    height: 1fr;
}

/* ---------------------------------------------------------------- common section parts */

.counts {
    height: auto;
    margin: 0 0 1 0;
}

.totals {
    height: 1;
    margin: 1 0 0 0;
}

.hint {
    height: auto;
    margin: 0 0 1 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

DataTable {
    height: 1fr;
    background: $base;
    scrollbar-size-vertical: 1;
}

DataTable:focus {
    background-tint: $foreground 0%;
}

DataTable > .datatable--header {
    background: $surface0;
    color: $foreground;
    text-style: bold;
}

DataTable:focus > .datatable--header {
    background-tint: $foreground 0%;
}

DataTable > .datatable--header-hover {
    background: $surface0;
}

DataTable > .datatable--hover {
    background: $surface0 50%;
}

DataTable > .datatable--cursor {
    background: $surface1;
    color: $foreground;
    text-style: none;
}

DataTable:focus > .datatable--cursor {
    background: $mauve;
    color: $crust;
    text-style: bold;
}

.split {
    height: 1fr;
}

.detail {
    width: 40%;
    min-width: 34;
    height: 1fr;
    border: round $surface1;
    border-title-color: $subtext0;
    border-title-style: bold;
    padding: 0 1;
    margin-left: 2;
}

.detail:focus {
    border: round $mauve;
    border-title-color: $mauve;
}

/* ---------------------------------------------------------------- job: cards, pipeline, recent runs */

#job {
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

.card {
    width: 100%;
    height: auto;
    border: round $surface1;
    border-title-color: $subtext0;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.card:focus {
    border: round $mauve;
    border-title-color: $mauve;
}

.panel {
    width: 100%;
    height: auto;
    border: round $surface0;
    border-title-color: $overlay0;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* ---------------------------------------------------------------- run dashboard */

.run-state {
    height: auto;
    margin: 0 0 1 0;
}

.banner {
    height: 1;
    background: $yellow;
    color: $crust;
    text-style: bold;
    margin: 0 0 1 0;
}

#dash {
    height: auto;
}

.bar-row {
    height: 1;
}

.bar-label {
    width: 7;
    color: $subtext0;
}

.bar-count {
    width: 24;
    padding-left: 2;
    color: $foreground;
}

.bar-row ProgressBar {
    width: 1fr;
}

.bar-row Bar {
    width: 1fr;
}

Bar > .bar--bar {
    color: $mauve;
    background: $surface1;
}

Bar > .bar--indeterminate {
    color: $surface1;
    background: $surface1;
}

Bar > .bar--complete {
    color: $green;
    background: $surface1;
}

PercentageStatus {
    text-style: bold;
    color: $foreground;
}

.stats {
    height: auto;
    margin: 1 0 0 0;
}

.now {
    height: 1;
    margin: 1 0 1 0;
}

#log {
    height: 1fr;
    min-height: 5;
    border: round $surface1;
    border-title-color: $subtext0;
    border-title-style: bold;
    padding: 0 1;
    background: $base;
    scrollbar-size-vertical: 1;
}

#log:focus {
    border: round $mauve;
    border-title-color: $mauve;
}

#run.-biglog #dash {
    display: none;
}

/* ---------------------------------------------------------------- home */

#home {
    height: 1fr;
    align: center top;
    padding: 3 4 0 4;
}

#home > * {
    width: 96;
    max-width: 100%;
}

#home-mark {
    height: auto;
}

#home-tagline {
    height: auto;
    margin: 1 0 2 0;
}

.home-label {
    height: 1;
    padding: 0 1;
}

#tools {
    height: auto;
    border: round $surface1;
    padding: 0;
    background: $base;
    scrollbar-size-vertical: 0;
}

#tools:focus {
    border: round $mauve;
    background-tint: $foreground 0%;
}

#home-foot {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
}

/* ---------------------------------------------------------------- shared nav lists (home tools, groups list) */

#tools > .option-list--option, #glist > .option-list--option, #oruns > .option-list--option {
    padding: 0 1;
}

#tools > .option-list--separator {
    color: $base;
}

#tools > .option-list--option-highlighted, #glist > .option-list--option-highlighted,
#oruns > .option-list--option-highlighted {
    background: $surface1;
    color: $foreground;
    text-style: none;
}

#tools:focus > .option-list--option-highlighted, #glist:focus > .option-list--option-highlighted,
#oruns:focus > .option-list--option-highlighted {
    background: $mauve;
    color: $crust;
    text-style: none;
}

#tools > .option-list--option-hover, #glist > .option-list--option-hover {
    background: $surface0;
}

/* ---------------------------------------------------------------- groups explorer */

#gnav {
    width: 38;
    height: 1fr;
    background: $mantle;
    padding: 1 0 0 0;
}

#gtabs {
    height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
}

#gfilter {
    height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
}

#glist {
    height: 1fr;
    border: none;
    padding: 0;
    background: $mantle;
    scrollbar-size-vertical: 1;
}

#glist:focus {
    border: none;
    background-tint: $foreground 0%;
}

#glist-empty {
    height: auto;
    padding: 1 2;
}

#gmain {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $base;
    border-left: outer $base;
}

#gmain:focus-within {
    border-left: outer $mauve;
}

#gstate {
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin: 0 0 1 0;
}

#gswitch {
    height: 1fr;
}

#gswitch > Vertical {
    height: 1fr;
}

#gswitch VimTable {
    height: auto;
    max-height: 1fr;
}

#detail {
    height: 1fr;
    border: round $surface1;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#detail:focus {
    border: round $mauve;
}

.gnote {
    height: auto;
    max-height: 12;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: outer $surface1;
}

#ops {
    height: auto;
}

#gsteps {
    margin: 1 0 0 0;
}

#gactivity {
    margin: 1 0 0 0;
}

#glog {
    height: 10;
    min-height: 5;
    margin: 1 0 0 0;
    border: round $surface1;
    border-title-color: $subtext0;
    border-title-style: bold;
    padding: 0 1;
    background: $base;
    scrollbar-size-vertical: 1;
}

#glog:focus {
    border: round $mauve;
    border-title-color: $mauve;
}

/* ---------------------------------------------------------------- onboard flow */

#onav {
    width: 32;
    height: 1fr;
    background: $mantle;
    padding: 1 0 0 0;
}

#oactions {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

.onav-label {
    height: 1;
    padding: 0 1;
    border-top: solid $surface0;
}

#oruns {
    height: 1fr;
    border: none;
    padding: 0;
    background: $mantle;
    scrollbar-size-vertical: 1;
}

#oruns:focus {
    border: none;
    background-tint: $foreground 0%;
}

#oruns > .option-list--separator {
    color: $mantle;
}

#oruns-empty {
    height: auto;
    padding: 0 1;
}

#omain {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $base;
    border-left: outer $base;
}

#omain:focus-within {
    border-left: outer $mauve;
}

#oswitch {
    height: 1fr;
}

#oswitch > Vertical {
    height: 1fr;
}

#oswitch VimTable, #gswitch VimTable {
    overflow-x: hidden;
}

#oswitch VimTable {
    height: auto;
    max-height: 1fr;
}

#oboxes {
    height: auto;
    margin: 1 0 0 0;
}

#ohead, #ocheck-head {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.obox {
    text-wrap: nowrap;
    text-overflow: ellipsis;
    width: 1fr;
    height: auto;
    min-height: 4;
    border: round $surface1;
    border-title-color: $subtext0;
    border-title-style: bold;
    padding: 0 1;
}

#omanual {
    margin: 0 1 0 0;
    border: round $peach 60%;
    border-title-color: $peach;
}

/* ---------------------------------------------------------------- modals */

ModalScreen {
    align: center middle;
    background: $crust 60%;
}

.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $mauve;
    border-title-color: $mauve;
    border-title-style: bold;
    border-title-background: $surface0;
    border-subtitle-background: $surface0;
    background: $surface0;
    padding: 1 2;
}

.dialog.wide {
    width: 100;
}

.dialog.picker {
    width: 100;
    height: 70%;
}

.dialog.viewer {
    width: 90%;
    height: 85%;
}

.prompt-row {
    height: 1;
    margin: 1 0 0 0;
    background: $surface1;
}

.prompt-glyph {
    width: 3;
    padding: 0 1;
    color: $overlay0;
    background: $surface1;
    text-style: bold;
}

.prompt-row:focus-within .prompt-glyph {
    color: $mauve;
}

.prompt-row Input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1 0 0;
    background: $surface1;
    color: $foreground;
}

.prompt-row Input:focus {
    border: none;
    background-tint: $foreground 0%;
}

.prompt-row Input > .input--placeholder {
    color: $overlay0;
}

.dialog OptionList {
    height: 1fr;
    border: none;
    padding: 0;
    background: $surface0;
    margin: 1 0 0 0;
}

.dialog OptionList:focus {
    border: none;
    background-tint: $foreground 0%;
}

.dialog OptionList > .option-list--option {
    padding: 0 1;
}

.dialog OptionList > .option-list--option-highlighted,
.dialog OptionList:focus > .option-list--option-highlighted {
    background: $mauve;
    color: $crust;
    text-style: bold;
}

#options-list {
    height: auto;
    max-height: 12;
}

#options-help, #picker-status, .error-line, .ask {
    height: auto;
    margin: 1 0 0 0;
}

#viewer {
    height: 1fr;
    background: $surface0;
}

.dialog.viewer.fit {
    width: 120;
    height: auto;
}

.dialog.fit #viewer {
    height: auto;
    max-height: 80vh;
}

PromptModal.-bottom {
    align: center bottom;
    background: transparent;
}

PromptModal.-bottom .dialog {
    width: 100%;
    max-width: 100%;
    padding: 0 1;
    margin: 0 0 1 0;
}

PromptModal.-bottom .prompt-row {
    margin: 0;
}

/* ---------------------------------------------------------------- command palette and toasts */

CommandPalette > Vertical {
    background: $surface0;
}

Toast {
    background: $surface0;
    color: $foreground;
}
