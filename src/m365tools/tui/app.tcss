/* One theme ("m365", see theme.py). Focused pane: heavy accent border. Everything else: thin, dim. */

Screen {
    background: $background;
    layout: vertical;
}

#header {
    height: 1;
    background: $panel;
}

#body {
    height: 1fr;
}

#keybar {
    height: 1;
    background: $panel;
}

/* ---------------------------------------------------------------- panes */

#sidebar {
    width: 30%;
    max-width: 44;
    min-width: 26;
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    background: $background;
    padding: 0;
}

#sidebar:focus {
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#sidebar > .option-list--option {
    padding: 0 0 1 0;
}

#sidebar > .option-list--option-highlighted {
    background: $panel;
}

#sidebar:focus > .option-list--option-highlighted {
    background: $accent 25%;
}

#main {
    width: 1fr;
    height: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

#main:focus-within {
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#switcher, .section {
    height: 1fr;
}

/* ---------------------------------------------------------------- common section parts */

.counts {
    height: auto;
    margin: 0 0 1 0;
}

.totals {
    height: 1;
    margin: 1 0 0 0;
}

.hint {
    height: auto;
    margin: 1 0 0 0;
}

DataTable {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $panel;
}

DataTable:focus > .datatable--cursor {
    background: $accent 30%;
    text-style: bold;
}

.split {
    height: 1fr;
}

.detail {
    width: 45%;
    height: 1fr;
    border: round $accent;
    border-title-color: $accent;
    padding: 0 1;
    margin-left: 1;
}

/* ---------------------------------------------------------------- job cards */

.card {
    height: auto;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
    margin: 0 0 1 0;
}

.card:focus {
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

/* ---------------------------------------------------------------- run dashboard */

.run-state {
    height: auto;
    margin: 0 0 1 0;
}

.banner {
    height: 1;
    background: $warning;
    color: $background;
    text-style: bold;
    margin: 0 0 1 0;
}

#dash {
    height: auto;
}

.bar-row {
    height: 1;
}

.bar-label {
    width: 7;
    color: $text-muted;
}

.bar-count {
    width: 24;
    padding-left: 2;
}

.bar-row ProgressBar {
    width: 1fr;
}

.bar-row Bar {
    width: 1fr;
}

Bar > .bar--bar {
    color: $accent;
    background: $panel;
}

Bar > .bar--complete {
    color: $success;
}

.stats {
    height: auto;
    margin: 1 0 0 0;
}

.now {
    height: 1;
    margin: 1 0 1 0;
}

#log {
    height: 1fr;
    min-height: 5;
    border-top: solid $panel-lighten-2;
    background: $background;
    scrollbar-size-vertical: 1;
}

#log:focus {
    border-top: solid $accent;
}

#run.-biglog #dash {
    display: none;
}

/* ---------------------------------------------------------------- modals */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    padding: 1 2;
}

.dialog.wide {
    width: 100;
}

.dialog.picker {
    width: 100;
    height: 70%;
}

.dialog.viewer {
    width: 90%;
    height: 85%;
}

.dialog Input {
    border: tall $panel-lighten-2;
    background: $background;
    margin: 1 0 0 0;
}

.dialog Input:focus {
    border: tall $accent;
}

.dialog OptionList {
    height: 1fr;
    border: none;
    background: $surface;
    margin: 1 0 0 0;
}

.dialog OptionList > .option-list--option-highlighted {
    background: $accent 30%;
    text-style: bold;
}

#options-list {
    height: auto;
    max-height: 12;
}

#options-help, #picker-status, .error-line, .ask {
    height: auto;
    margin: 1 0 0 0;
}

#viewer {
    height: 1fr;
}

PromptModal.-bottom {
    align: center bottom;
    background: transparent;
}

PromptModal.-bottom .dialog {
    width: 100%;
    max-width: 100%;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* ---------------------------------------------------------------- toasts */

Toast {
    background: $panel;
}
